# Required: create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Safety: test mode fills forms but never submits them.
APPLYD_TEST_MODE=true
APPLYD_BROWSER_HEADLESS=false
APPLYD_BROWSER_PROFILE=data/browser/apply-profile
APPLYD_RETRIEVAL_PROFILE=data/browser/retrieval-profile

# Optional broad discovery. SimplifyJobs discovery works without either key.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Optional Greenhouse email verification (Gmail uses an app password).
APPLYD_IMAP_USER=
APPLYD_IMAP_PASSWORD=
APPLYD_IMAP_HOST=imap.gmail.com
APPLYD_IMAP_PORT=993

# Optional Bright Data Browser API / Scraping Browser fallback.
# Easiest: paste the complete WebSocket endpoint from the Bright Data dashboard.
# Configure the desired exit country in that endpoint/zone; component settings
# below are ignored when this full URL is present.
BRIGHTDATA_CDP_URL=

# Alternative to BRIGHTDATA_CDP_URL: provide the endpoint components.
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_ZONE=
BRIGHTDATA_ZONE_PASSWORD=
BRIGHTDATA_COUNTRY=ca
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_CDP_PORT=9222
